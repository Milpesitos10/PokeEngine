# SQL Server authentication. Copy this file to .env and fill in the values locally.
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=CalculadoraPokemonDB
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Optional. If omitted, the API searches ESTADOS for "Activo" or "Active".
DB_ACTIVE_STATUS_ID=
